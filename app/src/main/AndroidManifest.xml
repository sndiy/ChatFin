<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions.
      Hanya minta yang benar-benar dipakai kode. USE_BIOMETRIC, USE_FINGERPRINT,
      READ_MEDIA_IMAGES, dan READ_EXTERNAL_STORAGE dihapus di M0 karena tidak ada
      satu pun kode yang menggunakannya — aplikasi keuangan yang meminta akses
      sidik jari dan galeri tanpa alasan merusak kepercayaan di halaman install.
      Kalau nanti fitur biometrik / foto struk benar-benar dibuat, tambahkan lagi
      bersama implementasinya.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup="false" — disengaja.
      Auto Backup meng-upload chatfin_database (seluruh data keuangan, plaintext)
      ke Google Drive, DAN meng-upload shared_prefs/chatfin_secure. Master key
      EncryptedSharedPreferences ada di Android Keystore dan tidak ikut ter-backup,
      jadi setelah restore ke device baru file itu tidak bisa didekripsi →
      SecureStorage melempar exception → crash di setiap launch.
      Backup manual (JSON) sudah tersedia di Setelan → Sinkronisasi & Backup.
      dataExtractionRules tetap dipasang karena device-to-device transfer di
      Android 12+ TIDAK dimatikan oleh allowBackup=false.
    -->
    <application
        android:name=".ChatFinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatFin"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ChatFin"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>