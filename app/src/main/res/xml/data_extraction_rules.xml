<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan ekstraksi data (Android 12 / API 31+).

   allowBackup="false" di manifest sudah mematikan <cloud-backup>, tapi
   <device-transfer> (transfer langsung HP lama → HP baru) TIDAK ikut mati.
   Jadi pengecualian di bawah tetap perlu ditulis eksplisit.

   Yang dikecualikan dan alasannya:
   - chatfin_secure  : EncryptedSharedPreferences. Master key-nya ada di Android
                       Keystore dan tidak bisa ikut berpindah device. Kalau file
                       ini ikut ditransfer, hasilnya tidak bisa didekripsi dan
                       SecureStorage melempar exception saat dibaca → crash-loop.
   - chatfin_database: seluruh riwayat keuangan dalam SQLite plaintext.
                       Tidak boleh berpindah device tanpa sepengetahuan user.
                       Jalur resminya adalah backup manual JSON di Setelan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="chatfin_secure.xml" />
        <exclude domain="database"   path="chatfin_database" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="sharedpref" path="chatfin_secure.xml" />
        <exclude domain="database"   path="chatfin_database" />
    </device-transfer>
</data-extraction-rules>
